# Copy to .env and fill in.
#
# TELEGRAM_BOT_TOKEN — get a NEW token from @BotFather on Telegram (FRIDAY needs
#   its own bot, separate from any OpenClaw bot). DM @BotFather → /newbot → follow
#   prompts → paste the token here.
# TELEGRAM_ALLOWLIST — comma-separated Telegram user IDs allowed to message FRIDAY.
#   Find your ID by DMing @userinfobot. Locks the bot to you only.
# FRIDAY_URL — orchestrator base URL. Default works for local dev.
# FRIDAY_API_KEY — must match the FRIDAY_API_KEY value in apps/orchestrator/.env
#   (the bot uses it as a Bearer token to call /v1/chat/completions).

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
FRIDAY_URL=http://127.0.0.1:3001
FRIDAY_API_KEY=
