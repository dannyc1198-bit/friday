# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
ORCHESTRATOR_URL=http://127.0.0.1:3001

# Same value as apps/orchestrator/.env FRIDAY_API_KEY.
# Required for the agent panel to route a task. Status dots work without it.
FRIDAY_API_KEY=

# Obsidian vault, same path the orchestrator uses.
OBSIDIAN_VAULT_PATH=C:\Users\12368\Obsidian\Wavelength

# Health Check
HEALTH_CHECK_INTERVAL=5000

# Feature Flags
NEXT_PUBLIC_VOICE_ENABLED=true
