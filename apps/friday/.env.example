# ============================================================
# Friday — env config
# Copy to .env, fill in keys. Friday boots with just LLM + voice + DB filled.
# All monitor data sources are optional — they degrade gracefully.
# ============================================================

# --- LLM ---
# Path A keeps Groq (free tier, decided 2026-04-27). To revert to Anthropic,
# set LLM_PROVIDER=anthropic and fill in ANTHROPIC_*. brain.py reads this var.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PICOVOICE_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://friday:friday@localhost:5432/friday

# --- Bridge to TS orchestrator (apps/orchestrator on port 3001) ---
# Path A: Python brain calls TS for tool execution.
ORCHESTRATOR_URL=http://127.0.0.1:3001
FRIDAY_API_KEY=

# --- Sidecar (apps/sidecar on port 3002) — optional eyes/face context ---
SIDECAR_URL=http://127.0.0.1:3002

# --- Monitor data sources (all optional) ---
# Stripe — Revenue monitor
STRIPE_SECRET_KEY=

# Supabase — Pipeline (leads) + PolyClaw monitors
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
POLYCLAW_SUPABASE_URL=
POLYCLAW_SUPABASE_KEY=

# Google — Comms monitor (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Server ---
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=3003
# Ports in use across the jarvis monorepo:
#   3000 = apps/web (Next.js HUD)
#   3001 = apps/orchestrator (Fastify)
#   3002 = apps/sidecar (FastAPI eyes/ears)
#   3003 = apps/friday (this — Python brain + WebSocket)

# --- OpenClaw integration (off by default per memory) ---
# OPENCLAW_WORKSPACE=
# OPENCLAW_API_KEY=
