# ============================================
# JARVIS Orchestrator Configuration
# ============================================

# OpenAI Configuration (REQUIRED for GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# User Configuration
USER_NAME=Danny

# Feature Flags
ENABLE_TOOLS=true
ENABLE_STREAMING=true

# ============================================
# MILESTONE 3: Provider Configuration
# ============================================

# --- Spotify Integration ---
# Get credentials at: https://developer.spotify.com/dashboard
# Required scopes: user-read-playback-state, user-modify-playback-state, user-read-currently-playing
MEDIA_PROVIDER=mock  # Set to "spotify" to enable real Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# --- Smart Home Integration ---
# Choose provider: "mock", "alexa", or "homeassistant"
SMART_HOME_PROVIDER=mock

# Alexa Smart Home (if using alexa)
# Setup at: https://developer.amazon.com/alexa/console
ALEXA_CLIENT_ID=your_alexa_client_id
ALEXA_CLIENT_SECRET=your_alexa_client_secret
ALEXA_REFRESH_TOKEN=your_alexa_refresh_token

# Home Assistant (if using homeassistant)
# Generate token in: Home Assistant → Profile → Long-Lived Access Tokens
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_home_assistant_token

# --- Bluetooth Integration ---
# Set to "true" to enable real Windows Bluetooth API
USE_REAL_BLUETOOTH=false

# ============================================
# MILESTONE 4: Voice Configuration (Future)
# ============================================

# OpenAI Whisper (Speech-to-Text)
WHISPER_MODEL=whisper-1

# OpenAI TTS (Text-to-Speech)
TTS_MODEL=tts-1
TTS_VOICE=onyx  # Options: alloy, echo, fable, onyx, nova, shimmer

# Wake Word Detection
WAKE_WORD_ENABLED=true
WAKE_WORD=hey jarvis

# ============================================
# MILESTONE 5: Mobile App (Future)
# ============================================

# Push Notifications
PUSH_NOTIFICATION_ENABLED=false
