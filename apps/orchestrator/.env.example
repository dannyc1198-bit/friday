# FRIDAY Orchestrator Configuration
# Copy to .env and fill in values. Never commit the real .env.
# OPENAI_API_KEY and ANTHROPIC_API_KEY are documented with the agent backends below.

PORT=
HOST=
CORS_ORIGIN=
USER_NAME=

ENABLE_TOOLS=
ENABLE_STREAMING=

MEDIA_PROVIDER=
SMART_HOME_PROVIDER=
USE_REAL_BLUETOOTH=

# ElevenLabs TTS. Leave the key empty to use the free Edge en-GB voice
# (en-GB-RyanNeural — calm British male). Never put a real key in git.
ELEVENLABS_API_KEY=
# auto (default) | elevenlabs | edge
TTS_PROVIDER=auto
# GLOBAL ElevenLabs voice override. If set, it wins over both personas.
ELEVENLABS_VOICE_ID=
# Per-persona ElevenLabs overrides. JARVIS default is Daniel (onwK4e9ZLuTAKqWW03F9).
FRIDAY_VOICE_ID_JARVIS=
FRIDAY_VOICE_ID_FRIDAY=
# Free Edge neural voices. EDGE_TTS_VOICE overrides both personas.
EDGE_TTS_VOICE=
EDGE_TTS_VOICE_JARVIS=en-GB-RyanNeural
EDGE_TTS_VOICE_FRIDAY=en-GB-SoniaNeural

# Obsidian vault (Wavelength). Read, search, and write notes here.
# Windows default if unset: %USERPROFILE%\Obsidian\Wavelength
OBSIDIAN_VAULT_PATH=C:\Users\12368\Obsidian\Wavelength

# Agent backends. Missing values show as "needs key" and never crash boot.
# Grok bots are status dots. Comma-separated. Each bot is three fields:
#   Name | status URL (GET) | dispatch URL (POST JSON {"agent","task"})
# Example:
# GROK_BOTS=Nexus|http://127.0.0.1:7777/health|http://127.0.0.1:7777/dispatch,Builder|http://127.0.0.1:7778/health|http://127.0.0.1:7778/dispatch
GROK_BOTS=
# Optional bearer sent on those status and dispatch calls.
GROK_BOT_TOKEN=
# Brain. Default chain is OpenAI, then xAI on quota, billing, or outage.
# A 400 stays on the provider that rejected it. Gemini and Claude are used
# only when FRIDAY_LLM_PROVIDER names them.
# OPENAI_MODEL defaults to gpt-6-astra. XAI_MODEL defaults to grok-4.7 when empty.
FRIDAY_LLM_PROVIDER=
FRIDAY_LLM_FAILOVER=
OPENAI_MODEL=
# OpenAI — brain, Realtime voice fallback, and the Codex CLI (`codex` on PATH).
OPENAI_API_KEY=
# Claude Code CLI (`claude` on PATH). The CLI's own login is enough.
ANTHROPIC_API_KEY=
# xAI Grok API. https://api.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

# Live Talk. ElevenLabs Agents is the voice. OpenAI Realtime is the fallback.
# FRIDAY_VOICE_MODE: elevenlabs (default) | realtime | browser
FRIDAY_VOICE_MODE=
ELEVENLABS_AGENT_ID=
# Workspace secret id whose value is FRIDAY_API_KEY. The configure script sends the id, not the key.
ELEVENLABS_SECRET_ID=
# Public https origin ElevenLabs can call. It cannot reach 127.0.0.1.
FRIDAY_PUBLIC_URL=
FRIDAY_REALTIME_MODEL=gpt-realtime
FRIDAY_REALTIME_VOICE=cedar

# Self-repair. Off by default so boot does not run tsc or npm test.
# FRIDAY_HEALTHCHECK=1 runs npx tsc --noEmit nightly and after a repeated failure.
# FRIDAY_HEALTHCHECK_TESTS=1 also runs npm test.
FRIDAY_HEALTHCHECK=
FRIDAY_HEALTHCHECK_TESTS=

# Chat memory is a local JSON file under apps/orchestrator/data/memory.
# Leave CHROMA_ENABLED empty. Set it to true only when a Chroma server is running.
CHROMA_ENABLED=
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_RETENTION_DAYS=
CHROMA_CONTEXT_LIMIT=
CHROMA_MIN_SIMILARITY=

# Creative tools. Empty keys show "needs key" on the HUD. Nothing crashes.
MESHY_API_KEY=
# Higgsfield: official pair, or one line id:secret in HIGGSFIELD_API_KEY.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_API_KEY=
# Optional model paths. Defaults: Soul image, Kling 3 standard text-to-video.
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_MODEL=
# Blender 5.0. Default is the path below when BLENDER_PATH is empty.
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
# Where GLB, FBX, previews, and generated media are saved.
FRIDAY_MEDIA_DIR=

# Web Search (Tavily)
TAVILY_API_KEY=

# Notion
NOTION_API_KEY=

# VAPI Phone Calls. Tool calls and the phone LLM are refused until one of
# these secrets is set. Send it as X-Vapi-Secret or Authorization: Bearer.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# ClawBridge base URL
OPENCLAW_BASE_URL=

# Netlify personal access token
NETLIFY_AUTH_TOKEN=

# Virtual Receptionist - Wavelength AI
RECEPTIONIST_VAPI_ASSISTANT_ID=
# Same gate as VAPI_WEBHOOK_SECRET. Either one unlocks phone tool calls.
RECEPTIONIST_WEBHOOK_SECRET=
RECEPTIONIST_CALENDAR_ID=
DANNY_EMAIL=
NGROK_URL=

# Google Calendar - Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail - App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API Authentication Keys (auto-generated on first boot)
JARVIS_API_KEY=
FRIDAY_API_KEY=

GEMINI_API_KEY=

FRIDAY_LLM_PROVIDER=

# Fleet integration (Agent OS cockpit at :7777)
AGENT_OS_URL=
AGENT_OS_TOKEN=

# Battle Station market dashboard (:9999)
BATTLE_STATION_URL=

# Osiris intel map (:4000)
OSIRIS_URL=

# Set to "true" to enable live OpenClaw workspace memory sync (default off)
OPENCLAW_SYNC=
