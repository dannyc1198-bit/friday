# FRIDAY Orchestrator Configuration
# Copy to .env and fill in values. Never commit the real .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

PORT=
HOST=
CORS_ORIGIN=
USER_NAME=

ENABLE_TOOLS=
ENABLE_STREAMING=

MEDIA_PROVIDER=
SMART_HOME_PROVIDER=
USE_REAL_BLUETOOTH=

# ElevenLabs TTS (Phase 1 Voice I/O)
ELEVENLABS_API_KEY=
# GLOBAL voice override — leave empty. If set, it wins over the switchable
# JARVIS/FRIDAY personas (switch_voice tool + services/voice-registry.ts).
ELEVENLABS_VOICE_ID=
# Per-persona voice overrides (paste a better voice ID without code changes)
FRIDAY_VOICE_ID_JARVIS=
FRIDAY_VOICE_ID_FRIDAY=

# Long-term Memory (FRIDAY learns and remembers)
CHROMA_ENABLED=
CHROMA_RETENTION_DAYS=
CHROMA_CONTEXT_LIMIT=
CHROMA_MIN_SIMILARITY=

# Web Search (Tavily)
TAVILY_API_KEY=

# Notion
NOTION_API_KEY=

# VAPI Phone Calls
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# ClawBridge base URL
OPENCLAW_BASE_URL=

# Netlify personal access token
NETLIFY_AUTH_TOKEN=

# Virtual Receptionist - Wavelength AI
RECEPTIONIST_VAPI_ASSISTANT_ID=
RECEPTIONIST_WEBHOOK_SECRET=
RECEPTIONIST_CALENDAR_ID=
DANNY_EMAIL=
NGROK_URL=

# Google Calendar - Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail - App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API Authentication Keys (auto-generated on first boot)
JARVIS_API_KEY=
FRIDAY_API_KEY=

GEMINI_API_KEY=

FRIDAY_LLM_PROVIDER=

# Fleet integration (Agent OS cockpit at :7777)
AGENT_OS_URL=
AGENT_OS_TOKEN=

# Battle Station market dashboard (:9999)
BATTLE_STATION_URL=

# Osiris intel map (:4000)
OSIRIS_URL=

# Set to "true" to enable live OpenClaw workspace memory sync (default off)
OPENCLAW_SYNC=
